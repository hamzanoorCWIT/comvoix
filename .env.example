# Contact form delivery via Brevo transactional email API (https://developers.brevo.com/reference/sendtransacemail)
BREVO_API_KEY=
# A sender address verified in your Brevo account
CONTACT_FROM_EMAIL=no-reply@comvoix.com
CONTACT_FROM_NAME=Comvoix Website
# Where contact requests are delivered
CONTACT_TO_EMAIL=sales@comvoix.com
